# ── Phase 1 required ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server / workers only — NEVER expose to the browser or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Phase 2–3: OpenAI ─────────────────────────────────────────
OPENAI_API_KEY=

# ── Phase 4: Kling image-to-video ─────────────────────────────
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# or
KLING_API_KEY=

# ── Phase 5: ElevenLabs ───────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Phase 4+: Railway workers / Redis ─────────────────────────
REDIS_URL=
# Railway injects its own PORT / service URLs in production

# ── Phase 6: YouTube Data API v3 ──────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# ── Phase 6: TikTok Content Posting API ───────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ── Phase 6: Instagram Graph API (Meta) ───────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
